{
  "id": "testplat",
  "name": "合成测试平台",
  "domains": [
    "jobs.example.invalid"
  ],
  "jobUrl": {
    "idPattern": "/jobs/([A-Za-z0-9-]+)",
    "stripQuery": false
  },
  "conversationKey": [
    "company",
    "recruiter"
  ],
  "recruiterFormat": "姓名(职务)",
  "activityLabels": {
    "recent": 0
  },
  "automationPolicy": {
    "forbidCDP": false,
    "forbidHeadless": false
  },
  "defaultLimits": {
    "greetsPerRun": 2
  },
  "timeLabels": {
    "relativeDays": {
      "today": 0,
      "yesterday": 1
    },
    "recent": [
      "just now"
    ],
    "weekdays": {
      "Monday": 1,
      "Tuesday": 2,
      "Wednesday": 3,
      "Thursday": 4,
      "Friday": 5,
      "Saturday": 6,
      "Sunday": 7
    },
    "dateFormats": [
      "YYYY-MM-DD"
    ],
    "timeFormat": "HH:MM",
    "dateTimeFormat": "<date> HH:MM"
  },
  "messageId": {
    "available": true
  }
}
